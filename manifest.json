{
  "manifest_version": 3,
  "name": "ChatMark",
  "version": "0.1.0",
  "description": "Export AI chat conversations to Markdown.",
  "action": {
    "default_title": "ChatMark",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["downloads"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
